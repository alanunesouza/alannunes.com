---
import '../styles/global.css';
import type { Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  lang?: Lang;
}

const {
  title = 'Alan Nunes | Senior Software Engineer',
  description = 'Site pessoal e blog de Alan Nunes, Senior Software Engineer especialista em Front-End e em especialização em Inteligência Artificial.',
  image = '/favicon.png',
  type = 'website',
  lang = 'pt',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://alannunes.com');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImageURL = new URL(image, siteUrl);

const htmlLang = lang === 'en' ? 'en' : 'pt-BR';
const ogLocale = lang === 'en' ? 'en_US' : 'pt_BR';

const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags Primárias -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Alan Nunes" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Alan Nunes" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- RSS & Sitemap Feeds -->
    <link rel="alternate" type="application/rss+xml" title="Alan Nunes | Blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Analytics (opcional via PUBLIC_GA_ID) -->
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script
            is:inline
            set:html={`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${gaId}');
            `}
          />
        </>
      )
    }

    <!-- Script inline Anti-FOUC para tema (executa antes da pintura da tela) -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDarkNow = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDarkNow ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>

    <!-- Limpeza de Service Worker legado do Gatsby -->
    <script is:inline>
      if (typeof navigator !== 'undefined' && 'serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          for (const registration of registrations) {
            registration.unregister();
          }
        });
      }
      if (typeof window !== 'undefined' && 'caches' in window) {
        caches.keys().then((keys) => {
          for (const key of keys) {
            caches.delete(key);
          }
        });
      }
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-primary)] text-[var(--text-primary)] transition-colors duration-200">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-brand-primary)] focus:text-white focus:rounded-lg focus:shadow-lg focus:outline-none text-sm font-semibold"
    >
      {lang === 'en' ? 'Skip to content' : 'Pular para o conteúdo'}
    </a>
    <slot />
  </body>
</html>
