---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import profileImg from '../../assets/profile.png';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');

const posts = await getCollection('blog', (p) => p.data.lang === 'en');
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recentPosts = posts.slice(0, 3);
---

<BaseLayout
  title="Alan Nunes | Senior Software Engineer"
  description="Personal website and blog of Alan Nunes, Senior Software Engineer specializing in Front-End with an active focus on Artificial Intelligence."
  lang="en"
>
  <div class="max-w-3xl mx-auto px-6 py-12 sm:py-20">
    <Header currentPath="/en" lang="en" />

    <!-- Hero Section -->
    <main class="py-16">
      <div class="flex flex-col-reverse sm:flex-row items-start sm:items-center justify-between gap-8">
        <div class="space-y-4">
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--text-primary)]">
            {t('hero.greeting')}
          </h1>
          <p class="text-lg text-[var(--text-secondary)] leading-relaxed">
            {t('hero.role')}
            <span class="font-semibold text-[var(--text-primary)]">{t('hero.company')}</span>.
            {t('hero.specialty')}
          </p>
        </div>

        <div class="relative shrink-0">
          <div
            class="w-28 h-28 sm:w-36 sm:h-36 rounded-full overflow-hidden border-2 border-[var(--border-subtle)] shadow-sm"
          >
            <Image
              src={profileImg}
              alt="Alan Nunes"
              width={288}
              height={288}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- Social Links -->
      <div class="mt-10 flex flex-wrap gap-4 text-sm font-medium">
        <a
          href="https://github.com/alanunesouza"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--color-brand-primary)] transition-colors"
        >
          GitHub →
        </a>
        <a
          href="https://www.linkedin.com/in/alanunesouza"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--color-brand-primary)] transition-colors"
        >
          LinkedIn →
        </a>
        <a
          href="https://twitter.com/alanhnunes"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--color-brand-accent)] transition-colors"
        >
          Twitter / X →
        </a>
      </div>

      <!-- Recent Articles Section -->
      {
        recentPosts.length > 0 && (
          <section class="mt-20 space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-[var(--border-subtle)]">
              <h2 class="text-xl font-bold tracking-tight text-[var(--text-primary)]">{t('home.recentArticles')}</h2>
              <a href="/en/blog" class="text-sm font-semibold text-[var(--color-brand-primary)] hover:underline">
                {t('home.viewAll')}
              </a>
            </div>

            <div class="flex flex-col gap-5">
              {recentPosts.map((post) => (
                <PostCard post={post} lang="en" />
              ))}
            </div>
          </section>
        )
      }
    </main>

    <!-- Minimalist Footer -->
    <footer
      class="pt-12 mt-12 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]"
    >
      <div>
        © {new Date().getFullYear()}
        {t('footer.rights')}
      </div>
      <div class="flex items-center gap-4">
        <a href="/policies" class="hover:text-[var(--text-primary)] transition-colors">{t('footer.privacy')}</a>
        <span>•</span>
        <a
          href="https://github.com/alanunesouza/alannunes.com/blob/master/LICENSE"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--text-primary)] transition-colors">{t('footer.terms')}</a
        >
      </div>
    </footer>
  </div>
</BaseLayout>
