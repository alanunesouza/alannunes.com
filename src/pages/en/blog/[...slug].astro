---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import CopyCode from '../../../components/CopyCode.astro';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const enPosts = allPosts.filter((post) => post.data.lang === 'en');

  return enPosts.map((post) => {
    const slug = post.id.replace(/^en\//, '');
    const ptPost = allPosts.find(
      (p) =>
        p.data.lang === 'pt' &&
        (p.data.translationRef === post.data.translationRef ||
          p.data.translationRef === slug ||
          post.data.translationRef === p.id.replace(/^pt\//, ''))
    );
    const ptSlug = ptPost ? ptPost.id.replace(/^pt\//, '') : null;

    return {
      params: { slug },
      props: { post, ptSlug },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  ptSlug: string | null;
}

const { post, ptSlug } = Astro.props;
const { title, date, tags, author, description } = post.data;
const t = useTranslations('en');

const { Content } = await render(post);

// Formatação amigável de data em en-US
const formattedDate = new Intl.DateTimeFormat('en-US', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(date);

// Cálculo do tempo aproximado de leitura
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

const cleanSlug = post.id.replace(/^en\//, '');
const alternatePath = {
  en: `/en/blog/${cleanSlug}`,
  pt: ptSlug ? `/blog/${ptSlug}` : '/blog',
};
---

<BaseLayout
  title={`${title} | Alan Nunes`}
  description={description ?? `${title} - Article by ${author}`}
  type="article"
  lang="en"
>
  <div class="max-w-3xl mx-auto px-6 py-12 sm:py-20">
    <Header currentPath={`/en/blog/${cleanSlug}`} lang="en" alternatePath={alternatePath} />

    <main class="py-12 sm:py-16">
      <!-- Back Button -->
      <a
        href="/en/blog"
        class="inline-flex items-center gap-2 text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors mb-8"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        {t('blog.back')}
      </a>

      <!-- Article Header -->
      <header class="space-y-4 pb-8 border-b border-[var(--border-subtle)] mb-10">
        <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--text-muted)]">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          <span>•</span>
          <span>{readingTime} {t('post.readTime')}</span>
          <span>•</span>
          <span>{t('post.by')} {author}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-tight">
          {title}
        </h1>

        {
          tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-2">
              {tags.map((tag) => (
                <span class="text-xs px-2.5 py-1 rounded-md bg-[var(--bg-surface)] text-[var(--text-secondary)] font-medium">
                  #{tag}
                </span>
              ))}
            </div>
          )
        }
      </header>

      <!-- Rendered Content via Prose -->
      <article
        class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-[var(--color-brand-primary)] prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-img:border prose-img:border-[var(--border-subtle)] prose-pre:rounded-xl prose-pre:border prose-pre:border-[var(--border-subtle)]"
      >
        <Content />
      </article>

      <CopyCode lang="en" />

      <!-- Article Footer Link -->
      <div class="mt-16 pt-8 border-t border-[var(--border-subtle)] flex items-center justify-between">
        <a
          href="/en/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-brand-primary)] hover:underline"
        >
          {t('blog.seeOther')}
        </a>
      </div>
    </main>

    <!-- Footer -->
    <footer
      class="pt-12 mt-12 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]"
    >
      <div>
        © {new Date().getFullYear()}
        {t('footer.rights')}
      </div>
      <div class="flex items-center gap-4">
        <a href="/policies" class="hover:text-[var(--text-primary)] transition-colors">{t('footer.privacy')}</a>
        <span>•</span>
        <a
          href="https://github.com/alanunesouza/alannunes.com/blob/master/LICENSE"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--text-primary)] transition-colors">{t('footer.terms')}</a
        >
      </div>
    </footer>
  </div>
</BaseLayout>
