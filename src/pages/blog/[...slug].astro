---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CopyCode from '../../components/CopyCode.astro';
import Giscus from '../../components/Giscus.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { ArrowLeft, ArrowRight, Calendar, Clock, User } from '@lucide/astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const ptPosts = allPosts.filter((post) => post.data.lang === 'pt');

  return ptPosts.map((post) => {
    const slug = post.id.replace(/^pt\//, '');
    const enPost = allPosts.find(
      (p) =>
        p.data.lang === 'en' &&
        (p.data.translationRef === post.data.translationRef ||
          p.data.translationRef === slug ||
          post.data.translationRef === p.id.replace(/^en\//, ''))
    );
    const enSlug = enPost ? enPost.id.replace(/^en\//, '') : null;

    return {
      params: { slug },
      props: { post, enSlug },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  enSlug: string | null;
}

const { post, enSlug } = Astro.props;
const { title, date, tags, author, description } = post.data;
const t = useTranslations('pt');

const { Content } = await render(post);

// Formatação amigável de data em pt-BR
const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(date);

// Cálculo do tempo aproximado de leitura
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

const cleanSlug = post.id.replace(/^pt\//, '');
const alternatePath = {
  pt: `/blog/${cleanSlug}`,
  en: enSlug ? `/en/blog/${enSlug}` : '/en/blog',
};
---

<BaseLayout
  title={`${title} | Alan Nunes`}
  description={description ?? `${title} - Artigo por ${author}`}
  image={post.data.image}
  publishDate={date.toISOString()}
  type="article"
  lang="pt"
>
  <div class="max-w-3xl mx-auto px-6 py-12 sm:py-20">
    <Header currentPath={`/blog/${cleanSlug}`} lang="pt" alternatePath={alternatePath} />

    <main id="main-content" class="py-12 sm:py-16">
      <!-- Botão Voltar -->
      <a
        href="/blog"
        class="group inline-flex items-center gap-2 text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors mb-8"
      >
        <ArrowLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
        {t('blog.back')}
      </a>

      <!-- Cabeçalho do Artigo -->
      <header class="space-y-4 pb-8 border-b border-[var(--border-subtle)] mb-10">
        <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--text-muted)]">
          <span class="inline-flex items-center gap-1.5">
            <Calendar class="w-3.5 h-3.5 text-[var(--color-brand-primary)]" />
            <time datetime={date.toISOString()}>{formattedDate}</time>
          </span>
          <span>•</span>
          <span class="inline-flex items-center gap-1.5">
            <Clock class="w-3.5 h-3.5 text-[var(--color-brand-accent)]" />
            <span>{readingTime} {t('post.readTime')}</span>
          </span>
          <span>•</span>
          <span class="inline-flex items-center gap-1.5">
            <User class="w-3.5 h-3.5 text-[var(--text-muted)]" />
            <span>{t('post.by')} {author}</span>
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-tight">
          {title}
        </h1>

        {
          tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-2">
              {tags.map((tag) => (
                <span class="text-xs px-2.5 py-1 rounded-md bg-[var(--bg-surface)] text-[var(--text-secondary)] border border-[var(--border-subtle)] font-medium">
                  #{tag}
                </span>
              ))}
            </div>
          )
        }
      </header>

      <!-- Conteúdo do Artigo -->
      <article
        class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-[var(--color-brand-primary)] prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl prose-img:border prose-img:border-[var(--border-subtle)] prose-pre:rounded-xl prose-pre:border prose-pre:border-[var(--border-subtle)]"
      >
        <Content />
      </article>

      <CopyCode lang="pt" />

      <!-- Compartilhamento Social -->
      <ShareButtons title={title} url={`/blog/${cleanSlug}`} lang="pt" />

      <!-- Rodapé do Artigo -->
      <div class="mt-12 pt-8 border-t border-[var(--border-subtle)] flex items-center justify-between">
        <a
          href="/blog"
          class="group inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-brand-primary)] hover:underline"
        >
          {t('blog.seeOther')}
          <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <!-- Seção de Comentários Comunitários via Giscus -->
      <Giscus lang="pt" />
    </main>

    <Footer lang="pt" />
  </div>
</BaseLayout>
