---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import BlogFilter from '../../components/BlogFilter.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('pt');

// Obter artigos em português ordenados do mais recente para o mais antigo
const posts = await getCollection('blog', (p) => p.data.lang === 'pt');
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Tags únicas para o filtro
const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags || []))).sort();
---

<BaseLayout
  title="Blog | Alan Nunes"
  description="Artigos e reflexões sobre engenharia de software, front-end, inteligência artificial e carreira técnica."
  lang="pt"
>
  <div class="max-w-3xl mx-auto px-6 py-12 sm:py-20">
    <Header currentPath="/blog" lang="pt" />

    <main id="main-content" class="py-12 sm:py-16">
      <div class="space-y-3 mb-10">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--text-primary)]">{t('blog.title')}</h1>
        <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed">
          {t('blog.subtitle')}
        </p>
      </div>

      <!-- Filtro por Busca e Tags -->
      <BlogFilter tags={allTags} lang="pt" />

      <!-- Listagem de Artigos -->
      <div class="flex flex-col gap-6" id="blog-posts-list">
        {
          posts.length > 0 ? (
            posts.map((post) => <PostCard post={post} lang="pt" />)
          ) : (
            <p class="text-sm text-[var(--text-muted)] py-12 text-center">{t('blog.empty')}</p>
          )
        }
      </div>
    </main>

    <Footer lang="pt" />
  </div>
</BaseLayout>
