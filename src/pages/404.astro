---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Página não encontrada | Alan Nunes" description="Erro 404: A página solicitada não foi encontrada.">
  <div class="max-w-3xl mx-auto px-6 py-12 sm:py-20 flex flex-col min-h-screen">
    <Header />

    <main class="flex-1 flex flex-col items-center justify-center text-center py-20">
      <span class="text-6xl sm:text-7xl font-extrabold text-[var(--color-brand-primary)] mb-4"> 404 </span>
      <h1 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-3">Página não encontrada</h1>
      <p class="text-base text-[var(--text-secondary)] max-w-md mb-8">
        O conteúdo que você está procurando pode ter sido movido, renomeado ou não existe mais.
      </p>

      <div class="flex items-center gap-4">
        <a
          href="/"
          class="px-5 py-2.5 rounded-lg bg-[var(--color-brand-primary)] text-white font-medium text-sm hover:opacity-90 transition-opacity"
        >
          Voltar ao início
        </a>
        <a
          href="/blog"
          class="px-5 py-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-primary)] font-medium text-sm hover:border-[var(--color-brand-primary)] transition-colors"
        >
          Ver o blog
        </a>
      </div>
    </main>

    <!-- Rodapé -->
    <footer class="pt-8 border-t border-[var(--border-subtle)] text-center text-xs text-[var(--text-muted)]">
      © {new Date().getFullYear()} alannunes.com • Todos os direitos reservados.
    </footer>
  </div>
</BaseLayout>
