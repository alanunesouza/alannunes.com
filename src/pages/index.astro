---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import profileImg from '../assets/profile.png';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('pt');

const posts = await getCollection('blog', (p) => p.data.lang === 'pt');
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recentPosts = posts.slice(0, 3);
---

<BaseLayout title="Alan Nunes | Senior Software Engineer" lang="pt">
  <div class="max-w-3xl mx-auto px-6 py-12 sm:py-20">
    <Header currentPath="/" lang="pt" />

    <!-- Apresentação Hero -->
    <main id="main-content" class="py-16">
      <div class="flex flex-col-reverse sm:flex-row items-start sm:items-center justify-between gap-8">
        <div class="space-y-4">
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--text-primary)]">
            {t('hero.greeting')}
          </h1>
          <p class="text-lg text-[var(--text-secondary)] leading-relaxed">
            {t('hero.role')}
            <span class="font-semibold text-[var(--text-primary)]">{t('hero.company')}</span>.
            {t('hero.specialty')}
          </p>
        </div>

        <div class="relative shrink-0">
          <div
            class="w-28 h-28 sm:w-36 sm:h-36 rounded-full overflow-hidden border-2 border-[var(--border-subtle)] shadow-sm"
          >
            <Image
              src={profileImg}
              alt="Alan Nunes"
              width={288}
              height={288}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- Links Sociais com Ícones -->
      <SocialLinks class="pt-8" />

      <!-- Artigos Recentes -->
      {
        recentPosts.length > 0 && (
          <section class="pt-16 sm:pt-20">
            <div class="flex items-center justify-between mb-8">
              <h2 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">{t('home.recentArticles')}</h2>
              <a
                href="/blog"
                class="group inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-brand-primary)] hover:underline"
              >
                {t('home.viewAll')}
                <ArrowRight class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </div>

            <div class="grid gap-6">
              {recentPosts.map((post) => (
                <PostCard post={post} lang="pt" />
              ))}
            </div>
          </section>
        )
      }
    </main>

    <Footer lang="pt" />
  </div>
</BaseLayout>
