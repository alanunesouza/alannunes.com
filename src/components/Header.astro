---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props {
  currentPath?: string;
  lang?: Lang;
  alternatePath?: {
    pt?: string;
    en?: string;
  };
}

const currentPath = Astro.props.currentPath ?? Astro.url.pathname;
const currentLang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const alternatePath = Astro.props.alternatePath;
const t = useTranslations(currentLang);

const homeHref = currentLang === 'en' ? '/en' : '/';
const blogHref = currentLang === 'en' ? '/en/blog' : '/blog';
const aboutHref = currentLang === 'en' ? '/en/about' : '/about';

const isBlog = currentPath.startsWith('/blog') || currentPath.startsWith('/en/blog');
const isAbout = currentPath.startsWith('/about') || currentPath.startsWith('/en/about');

const ptHref = alternatePath?.pt ?? getLocalizedPath(currentPath, 'pt');
const enHref = alternatePath?.en ?? getLocalizedPath(currentPath, 'en');
---

<header class="flex items-center justify-between pb-8 sm:pb-12 border-b border-[var(--border-subtle)]">
  <a href={homeHref} class="text-xl font-bold tracking-tight text-[var(--text-primary)] hover:opacity-80 transition-opacity">
    ala<span class="text-[var(--color-brand-primary)]">n</span><span class="text-[var(--color-brand-accent)]">n</span>unes
  </a>

  <div class="flex items-center gap-4 sm:gap-6">
    <nav class="flex items-center gap-4 sm:gap-5 text-sm font-medium">
      <a
        href={blogHref}
        class={`transition-colors ${isBlog ? 'text-[var(--color-brand-primary)] font-semibold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]'}`}
      >
        {t('nav.blog')}
      </a>
      <a
        href={aboutHref}
        class={`transition-colors ${isAbout ? 'text-[var(--color-brand-primary)] font-semibold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]'}`}
      >
        {t('nav.about')}
      </a>
    </nav>

    <!-- Seletor de Idioma Minimalista (PT | EN) -->
    <div
      class="flex items-center gap-1 px-1 py-0.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-xs font-semibold"
    >
      <a
        href={ptHref}
        class={`px-2 py-0.5 rounded transition-colors ${currentLang === 'pt' ? 'bg-[var(--bg-secondary)] text-[var(--color-brand-primary)] shadow-xs' : 'text-[var(--text-muted)] hover:text-[var(--text-primary)]'}`}
        aria-label="PT - Português"
      >
        PT
      </a>
      <span class="text-[var(--border-subtle)] text-[10px]">|</span>
      <a
        href={enHref}
        class={`px-2 py-0.5 rounded transition-colors ${currentLang === 'en' ? 'bg-[var(--bg-secondary)] text-[var(--color-brand-primary)] shadow-xs' : 'text-[var(--text-muted)] hover:text-[var(--text-primary)]'}`}
        aria-label="EN - English"
      >
        EN
      </a>
    </div>

    <!-- Botão Minimalista de Tema -->
    <button
      id="theme-toggle"
      type="button"
      aria-label={t('theme.toggle')}
      class="p-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
    >
      <!-- Sol (exibido no modo escuro) -->
      <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
        ></path>
      </svg>
      <!-- Lua (exibido no modo claro) -->
      <svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (btn && !btn.dataset.bound) {
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    }
  }

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
